  {
   "title": "",
   "text": "<p>&nbsp;</p>",
   "text_selected_editor": "tinymce",
   "autop": true,
   "_sow_form_id": "d7e1f270a86e4",
   "_sow_form_timestamp": "1792424471381",
   "option_name": "widget_sow-editor",
   "panels_info": {
