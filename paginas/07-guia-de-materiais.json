  {
   "title": "",
   "text": "<h1 style=\"text-align:center;color:#224a85;\">Guia de materiais</h1><hr style=\"width:56px;border:0;border-top:3px solid #224a85;margin:6px auto 18px;\" /><p style=\"text-align:center;\">Escolha o filamento certo para a sua peça.</p>",
   "text_selected_editor": "tinymce",
   "autop": true,
   "_sow_form_id": "93685e746f444",
   "_sow_form_timestamp": "1792424471381",
